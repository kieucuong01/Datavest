[Unit]
Description=DataVest Celery worker
After=network-online.target postgresql.service redis-server.service datavest-api.service

[Service]
Type=simple
WorkingDirectory=/opt/datavest/current/backend
EnvironmentFile=/opt/datavest/shared/.env
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/datavest/current/.venv/bin/celery -A app.celery_app:celery_app worker --loglevel=WARNING -Q jobs,ai,maintenance,trading-agents --concurrency=1
Restart=on-failure
RestartSec=8
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/datavest/shared
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=500M
TasksMax=192

[Install]
WantedBy=default.target
